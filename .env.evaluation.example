# Copy to .env.evaluation. This file is read only by the evaluation runner.
# Recommended: configure NVIDIA_API_KEY in the host environment or uncomment below.
# NVIDIA_API_KEY=your-key
# Defaults are selected in evals/lib.mjs; no key or endpoint is needed for fixtures.
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_REASONING_EFFORT=none
# EVAL_MAX_TOKENS=4096

# Alternative: explicitly configure a generic OpenAI-compatible endpoint.
# EVAL_API_BASE_URL=http://127.0.0.1:11434/v1
# EVAL_MODEL=replace-with-your-installed-model
# EVAL_API_KEY=only-if-your-endpoint-requires-one
