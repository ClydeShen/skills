<object id="enforcement" label="API enforcement&lt;br&gt;[Software system boundary]" c4Type="Software system boundary"><mxCell vertex="1" parent="aws"  style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fontFamily=Arial;fillColor=none;strokeColor=#52616B;strokeWidth=1.5;dashed=1;container=1;collapsible=0;align=left;verticalAlign=top;spacingLeft=18;spacingTop=15;"><mxGeometry x="90" y="470" width="900" height="530" as="geometry"/></mxCell></object>
