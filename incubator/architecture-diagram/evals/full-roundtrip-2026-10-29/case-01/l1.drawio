<object id="purpose" label="Requirement: Authenticate users and authorize each API request." ><mxCell vertex="1" parent="1"  style="text;html=1;fontSize=12;fontFamily=Arial;align=left;verticalAlign=middle;"><mxGeometry x="70" y="85" width="2310" height="30" as="geometry"/></mxCell></object>
