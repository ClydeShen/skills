<object id="web" label="Web sign-in page&lt;br&gt;[Container: Web app]&lt;br&gt;Collects and submits credentials;&lt;br&gt;does not verify the password." c4Type="Container" technology="Web app"><mxCell vertex="1" parent="1"  style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#52616B;fillColor=#F6F8FA;align=center;verticalAlign=middle;"><mxGeometry x="150" y="750" width="260" height="180" as="geometry"/></mxCell></object>
<object id="cognito" label="Amazon Cognito user pool&lt;br&gt;[Container: Amazon Cognito]&lt;br&gt;Verifies password; authenticates user;&lt;br&gt;issues tokens." c4Type="Container" technology="Amazon Cognito" iconKey="aws4-3a4eb7f7de18b92d" vendor="AWS"><mxCell vertex="1" parent="aws"  style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;fontFamily=Arial;labelWidth=280;spacingTop=8;"><mxGeometry x="290" y="180" width="72" height="72" as="geometry"/></mxCell></object>
<object id="gateway" label="Amazon API Gateway&lt;br&gt;[Container: AWS managed service]&lt;br&gt;Enforces the authorization result." c4Type="Container" technology="AWS managed service" iconKey="aws4-dd11693e05989a1c" vendor="AWS"><mxCell vertex="1" parent="enforcement"  style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fontFamily=Arial;labelWidth=280;spacingTop=8;"><mxGeometry x="200" y="134" width="72" height="72" as="geometry"/></mxCell></object>
<object id="authorizer" label="Lambda authorizer&lt;br&gt;[Container: AWS Lambda]&lt;br&gt;Verifies the token; queries policy." c4Type="Container" technology="AWS Lambda" iconKey="aws4-7590b3d50ef7fcb4" vendor="AWS"><mxCell vertex="1" parent="enforcement"  style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=Arial;labelWidth=280;spacingTop=8;"><mxGeometry x="600" y="134" width="72" height="72" as="geometry"/></mxCell></object>
<object id="permissions" label="Amazon Verified Permissions&lt;br&gt;[Container: AWS managed service]&lt;br&gt;Decision endpoint;&lt;br&gt;makes policy decisions." c4Type="Container" technology="AWS managed service" iconKey="aws4-f88b2033abcc5b6d" vendor="AWS"><mxCell vertex="1" parent="aws"  style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.verified_permissions;fontFamily=Arial;labelWidth=280;spacingTop=8;"><mxGeometry x="1350" y="604" width="72" height="72" as="geometry"/></mxCell></object>
<object id="backend" label="Backend APIs&lt;br&gt;[Container: REST API]" c4Type="Container" technology="REST API"><mxCell vertex="1" parent="aws"  style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#52616B;fillColor=#F6F8FA;align=center;verticalAlign=middle;"><mxGeometry x="1250" y="340" width="240" height="110" as="geometry"/></mxCell></object>
<object id="token-example" label="ID token example (Step 1)&lt;br&gt;cognito:username = alex&lt;br&gt;custom:tenantId = T-001&lt;br&gt;custom:type = Customer&lt;br&gt;cognito:groups = [Customers]" annotationKind="comment" annotationFor="cognito"><mxCell vertex="1" parent="1" annotationKind="comment" annotationFor="cognito" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="1300" y="270" width="620" height="220" as="geometry"/></mxCell></object>
<object id="legend" label="Legend&lt;br&gt;[Type: technology] = C4 element caption; outlined groups = architectural domains.&lt;br&gt;1–5 = request sequence; 5′ = alternative failure response.&lt;br&gt;Solid filled arrow = caller → callee; dashed arrow = auxiliary policy query.&lt;br&gt;Normal token return is folded into Step 1. Yellow note = example ID token attributes." annotationKind="legend"><mxCell vertex="1" parent="1" annotationKind="legend" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#52616B;fillColor=#F6F8FA;align=center;verticalAlign=middle;align=left;spacingLeft=18;spacingTop=12;verticalAlign=top;"><mxGeometry x="760" y="1330" width="1250" height="150" as="geometry"/></mxCell></object>
<mxCell id="uses" value="0. Uses sign-in page&lt;br&gt;(username + password)" edge="1" source="user" target="web" parent="1" style="edgeStyle=none;rounded=0;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#263C4A;strokeWidth=1.6;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="step1" value="1. Authenticate (returns tokens)&lt;br&gt;Username + password [HTTPS]" edge="1" source="web" target="cognito" parent="1" style="edgeStyle=none;rounded=0;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#263C4A;strokeWidth=1.6;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1388888888888889;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;"><mxGeometry x="0.7" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="775"/><mxPoint x="500" y="396"/></Array></mxGeometry></mxCell>
<mxCell id="step2" value="2. API request with token&lt;br&gt;[HTTPS; each request]" edge="1" source="web" target="gateway" parent="1" style="edgeStyle=none;rounded=0;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#263C4A;strokeWidth=1.6;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3888888888888889;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;"><mxGeometry x="-0.47" y="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="step3" value="3. Pass token for authorization&lt;br&gt;[Generic AWS invocation]" edge="1" source="gateway" target="authorizer" parent="1" style="edgeStyle=none;rounded=0;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#263C4A;strokeWidth=1.6;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="step4" value="4. Query policy: is request allowed?&lt;br&gt;[HTTPS]" edge="1" source="authorizer" target="permissions" parent="1" style="edgeStyle=none;rounded=0;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#263C4A;strokeWidth=1.6;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;dashed=1;dashPattern=6 4;"><mxGeometry x="0.3" y="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="step5" value="5. Forward allowed request&lt;br&gt;[HTTPS; if allowed]" edge="1" source="gateway" target="backend" parent="1" style="edgeStyle=none;rounded=0;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#263C4A;strokeWidth=1.6;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;"><mxGeometry x="0.2" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1086" y="575"/><mxPoint x="2010" y="575"/></Array></mxGeometry></mxCell>
<mxCell id="failure" value="5′. HTTP 403 + authorization error message&lt;br&gt;[HTTPS; if authorization fails]" edge="1" source="gateway" target="web" parent="1" style="edgeStyle=none;rounded=0;html=1;fontSize=12;fontFamily=Arial;fontColor=#17202A;strokeColor=#263C4A;strokeWidth=1.6;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7777777777777778;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;fontStyle=1;"><mxGeometry x="0.32" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="840"/><mxPoint x="910" y="1000"/><mxPoint x="280" y="1000"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
