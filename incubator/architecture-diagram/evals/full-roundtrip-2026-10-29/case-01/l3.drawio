<object id="web" label="Web sign-in page&lt;br&gt;[Container: Web app]&lt;br&gt;&lt;br&gt;Collects and submits credentials&lt;br&gt;Does not verify the password" c4Type="Container" technology="Web app"><mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;autosizeText=0;fontColor=#172B4D;strokeColor=#64748B;fillColor=#FFFFFF;"><mxGeometry x="450" y="560" width="240" height="150" as="geometry"/></mxCell></object>
<object id="cognito" label="Amazon Cognito user pool&lt;br&gt;[Container: Amazon Cognito]&lt;br&gt;Verifies the password, authenticates&lt;br&gt;the user, and issues tokens" c4Type="Container" technology="Amazon Cognito" iconKey="aws4-3a4eb7f7de18b92d" vendor="AWS"><mxCell vertex="1" parent="aws" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;labelWidth=290;spacingTop=10;whiteSpace=wrap;autosizeText=0;"><mxGeometry x="350" y="120" width="72" height="72" as="geometry"/></mxCell></object>
<object id="gateway" label="Amazon API Gateway&lt;br&gt;[Container: AWS managed service]&lt;br&gt;Enforces the authorization result" c4Type="Container" technology="AWS managed service" iconKey="aws4-dd11693e05989a1c" vendor="AWS"><mxCell vertex="1" parent="enforcement" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;labelWidth=290;spacingTop=10;whiteSpace=wrap;autosizeText=0;"><mxGeometry x="200" y="120" width="72" height="72" as="geometry"/></mxCell></object>
<object id="authorizer" label="Lambda authorizer&lt;br&gt;[Container: AWS Lambda]&lt;br&gt;Verifies the token and queries policy" c4Type="Container" technology="AWS Lambda" iconKey="aws4-c03eacaa5d134e9b" vendor="AWS"><mxCell vertex="1" parent="enforcement" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.lambda_function;labelWidth=290;spacingTop=10;whiteSpace=wrap;autosizeText=0;"><mxGeometry x="750" y="120" width="72" height="72" as="geometry"/></mxCell></object>
<object id="permissions" label="Amazon Verified Permissions&lt;br&gt;[Container: AWS managed service]&lt;br&gt;Decision endpoint; makes policy decisions" c4Type="Container" technology="AWS managed service" iconKey="aws4-f88b2033abcc5b6d" vendor="AWS"><mxCell vertex="1" parent="aws" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.verified_permissions;labelWidth=290;spacingTop=10;whiteSpace=wrap;autosizeText=0;"><mxGeometry x="1400" y="420" width="72" height="72" as="geometry"/></mxCell></object>
<object id="backend" label="Backend APIs&lt;br&gt;[Container: REST API]" c4Type="Container" technology="REST API"><mxCell vertex="1" parent="aws" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;autosizeText=0;fontColor=#172B4D;strokeColor=#64748B;fillColor=#FFFFFF;"><mxGeometry x="280" y="900" width="240" height="110" as="geometry"/></mxCell></object>
<object id="token-note" label="Step 1 — example ID token attributes&lt;br&gt;cognito:username = alex&lt;br&gt;custom:tenantId = T-001&lt;br&gt;custom:type = Customer&lt;br&gt;cognito:groups = [Customers]" annotationKind="comment" annotationFor="cognito"><mxCell vertex="1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="1730" y="240" width="660" height="180" as="geometry"/></mxCell></object>
<object id="failure-note" label="The authorization error message text&lt;br&gt;is not specified." annotationKind="comment" annotationFor="gateway"><mxCell vertex="1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="440" y="1000" width="480" height="120" as="geometry"/></mxCell></object>
<object id="unknown-note" label="Token-verification method and policy rules&lt;br&gt;are not specified.&lt;br&gt;No separate return from the policy decision&lt;br&gt;service or the authorizer is specified." annotationKind="comment" annotationFor="authorizer"><mxCell vertex="1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="1850" y="1040" width="690" height="190" as="geometry"/></mxCell></object>
<object id="legend" label="Legend&lt;br&gt;[Type: technology] = C4 element caption. Outlined groups = architectural domains.&lt;br&gt;0 = User sign-in; 1–5 = request sequence; 5′ = alternative failure response.&lt;br&gt;Solid filled arrow = caller to callee. Dashed arrow = auxiliary policy query. Yellow note = example ID token attributes / architectural comments.&lt;br&gt;Normal token return is folded into Step 1. All relationships have one caller-to-callee arrowhead." annotationKind="legend"><mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;autosizeText=0;fontColor=#172B4D;strokeColor=#64748B;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=16;"><mxGeometry x="60" y="1390" width="2690" height="150" as="geometry"/></mxCell></object>
<mxCell id="s0" value="0. Use sign-in page&lt;br&gt;Username and password&lt;br&gt;[Protocol not stated]" edge="1" parent="1" source="user" target="web" style="edgeStyle=none;rounded=0;html=1;fontSize=12;autosizeText=0;strokeWidth=1.5;strokeColor=#243746;fontColor=#172B4D;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="s1" value="1. Authenticate (returns tokens)&lt;br&gt;Username and password [HTTPS]" edge="1" parent="1" source="web" target="cognito" style="edgeStyle=none;rounded=0;html=1;fontSize=12;autosizeText=0;strokeWidth=1.5;strokeColor=#243746;fontColor=#172B4D;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry x="-0.135" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="336"/></Array></mxGeometry></mxCell>
<mxCell id="s2" value="2. API request with token&lt;br&gt;On each request [HTTPS]" edge="1" parent="1" source="web" target="gateway" style="edgeStyle=none;rounded=0;html=1;fontSize=12;autosizeText=0;strokeWidth=1.5;strokeColor=#243746;fontColor=#172B4D;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.4861111111111111;exitPerimeter=0;entryPerimeter=0;"><mxGeometry x="-0.56" y="0" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="s3" value="3. Pass token for authorization&lt;br&gt;[Generic AWS invocation]" edge="1" parent="1" source="gateway" target="authorizer" style="edgeStyle=none;rounded=0;html=1;fontSize=12;autosizeText=0;strokeWidth=1.5;strokeColor=#243746;fontColor=#172B4D;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1386" y="550"/><mxPoint x="1936" y="550"/></Array></mxGeometry></mxCell>
<mxCell id="s4" value="4. Query policy:&lt;br&gt;is request allowed?&lt;br&gt;[HTTPS]" edge="1" parent="1" source="authorizer" target="permissions" style="edgeStyle=none;rounded=0;html=1;fontSize=12;autosizeText=0;strokeWidth=1.5;strokeColor=#243746;fontColor=#172B4D;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;"><mxGeometry x="-0.45" y="0" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="s5" value="5. If allowed: forward allowed request&lt;br&gt;[HTTPS]" edge="1" parent="1" source="gateway" target="backend" style="edgeStyle=none;rounded=0;html=1;fontSize=12;autosizeText=0;strokeWidth=1.5;strokeColor=#243746;fontColor=#172B4D;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry x="0.39" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="654"/><mxPoint x="1550" y="1135"/></Array></mxGeometry></mxCell>
<mxCell id="s5fail" value="5′. If authorization fails:&lt;br&gt;HTTP 403 + authorization error message&lt;br&gt;[HTTPS]" edge="1" parent="1" source="gateway" target="web" style="edgeStyle=none;rounded=0;html=1;fontSize=12;autosizeText=0;strokeWidth=1.5;strokeColor=#243746;fontColor=#172B4D;startArrow=none;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;fontStyle=1;"><mxGeometry x="0.295" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="654"/><mxPoint x="1100" y="830"/><mxPoint x="570" y="830"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
