<object id="legend" label="Legend&lt;br&gt;&lt;font color=&quot;#0072B2&quot;&gt;A — blue dashed: DNS queries and DNS traffic routing, port 53&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D55E00&quot;&gt;B — orange solid: HTTPS requests/routing, port 443, then API invocation&lt;/font&gt;&lt;br&gt;Numbering is independent per flow. a/b/c selects dev/test/prod; one environment per request.&lt;br&gt;Filled arrow: caller → callee or explicitly labeled infrastructure traffic routing.&lt;br&gt;Normal responses are folded into request labels. Boundaries identify architectural domains." annotationKind="legend"><mxCell vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F6F7F9;strokeColor=#637180;align=left;verticalAlign=top;spacing=12;fontSize=12;"><mxGeometry x="40" y="2070" width="1320" height="230" as="geometry"/></mxCell></object>
<object id="allowances" label="&lt;b&gt;Firewall allowance table — applies to BOTH Azure Firewall AND AWS Network Firewall&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;7&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr&gt;&lt;th&gt;Environment&lt;/th&gt;&lt;th&gt;Source&lt;/th&gt;&lt;th&gt;Destination&lt;/th&gt;&lt;th&gt;Port&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dev&lt;/td&gt;&lt;td&gt;dev spoke subnet&lt;/td&gt;&lt;td&gt;Route 53 inbound endpoint IPs&lt;/td&gt;&lt;td&gt;53&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;test&lt;/td&gt;&lt;td&gt;test spoke subnet&lt;/td&gt;&lt;td&gt;Route 53 inbound endpoint IPs&lt;/td&gt;&lt;td&gt;53&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;prod&lt;/td&gt;&lt;td&gt;prod spoke subnet&lt;/td&gt;&lt;td&gt;Route 53 inbound endpoint IPs&lt;/td&gt;&lt;td&gt;53&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dev/test/prod&lt;/td&gt;&lt;td&gt;corresponding spoke subnet&lt;/td&gt;&lt;td&gt;*.execute-api.{region}.amazonaws.com&lt;/td&gt;&lt;td&gt;443&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" ><mxCell vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#202830;align=left;verticalAlign=top;spacing=5;"><mxGeometry x="1500" y="2070" width="2260" height="270" as="geometry"/></mxCell></object>
