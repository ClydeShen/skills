<object id="identity-note" label="Authentication input may be basic or bearer.&lt;br&gt;APIM authenticates against Azure AD B2C.&lt;br&gt;Identity exchange implementation is unspecified." annotationKind="comment" annotationFor="b2c"><mxCell vertex="1" parent="azure" annotationKind="comment" annotationFor="b2c" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="910" y="50" width="1110" height="140" as="geometry"/></mxCell></object>
<object id="controls-note" label="&lt;b&gt;APIM controls after authentication&lt;/b&gt;&lt;br&gt;Check system-account roles.&lt;br&gt;Require a user profile for both amendment methods." annotationKind="comment" annotationFor="policy"><mxCell vertex="1" parent="apim" annotationKind="comment" annotationFor="policy" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="50" y="730" width="650" height="120" as="geometry"/></mxCell></object>
<object id="auth-note" label="Common-Authx-Handler checks the user-profile role.&lt;br&gt;This is distinct from APIM system-account role checks." annotationKind="comment" annotationFor="auth"><mxCell vertex="1" parent="inbound" annotationKind="comment" annotationFor="auth" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="50" y="1040" width="450" height="150" as="geometry"/></mxCell></object>
<object id="transform-note" label="&lt;b&gt;Both sub-workflows&lt;/b&gt;&lt;br&gt;Validate XML, method, and malformed base64.&lt;br&gt;Wrap decoded XML in JSON.&lt;br&gt;JSON response → Liquid template → XML.&lt;br&gt;Return XML through the originating SOAP API." annotationKind="comment" annotationFor="order"><mxCell vertex="1" parent="sub" annotationKind="comment" annotationFor="order" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="50" y="770" width="540" height="250" as="geometry"/></mxCell></object>
<object id="failure-note" label="&lt;b&gt;Failure handling&lt;/b&gt;&lt;br&gt;Hide internal errors, e.g. an AWS-call timeout.&lt;br&gt;Return only a generic error through the originating SOAP entry:&lt;br&gt;Legacy → existing integrators;&lt;br&gt;Partner → new integrators.&lt;br&gt;Exact error schema / status is unspecified." annotationKind="comment" annotationFor="legacy"><mxCell vertex="1" parent="1" annotationKind="comment" annotationFor="legacy" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="60" y="1240" width="300" height="390" as="geometry"/></mxCell></object>
<object id="aws-note" label="AWS amend operation and response schema are unspecified.&lt;br&gt;Individual business rules and call frequency are unspecified." annotationKind="comment" annotationFor="validation"><mxCell vertex="1" parent="aws" annotationKind="comment" annotationFor="validation" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="50" y="790" width="580" height="170" as="geometry"/></mxCell></object>
