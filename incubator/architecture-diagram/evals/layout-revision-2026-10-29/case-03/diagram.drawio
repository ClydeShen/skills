<object id="conversion" label="&lt;b&gt;Both sub-workflows&lt;/b&gt;&lt;br&gt;Validate XML, method and malformed base64.&lt;br&gt;Wrap decoded XML in JSON.&lt;br&gt;JSON response → Liquid template → XML.&lt;br&gt;Return XML through the originating SOAP API." annotationKind="comment" annotationFor="orders"><mxCell vertex="1" parent="1" annotationKind="comment" annotationFor="orders" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="1840" y="1080" width="430" height="160" as="geometry"/></mxCell></object>
<object id="errors" label="&lt;b&gt;Failure handling&lt;/b&gt;&lt;br&gt;Hide internal errors, e.g. AWS-call timeout.&lt;br&gt;Return only a generic error response through the originating SOAP entry:&lt;br&gt;Legacy → existing integrators;&lt;br&gt;Partner → new integrators." annotationKind="comment" annotationFor="apimpolicy"><mxCell vertex="1" parent="1" annotationKind="comment" annotationFor="apimpolicy" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=20;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;"><mxGeometry x="620" y="1560" width="570" height="160" as="geometry"/></mxCell></object>
