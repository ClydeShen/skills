<mxfile host="app.diagrams.net" version="32.6.1" compressed="false"><diagram id="scenario-01" name="Scenario 01"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1040"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Dynamic diagram (deployment view): Token-based API authorization" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontStyle=1;"><mxGeometry x="60" y="25" width="1730" height="28" as="geometry"/></mxCell><mxCell id="requirement" value="Requirement: Authenticate users and authorize each API request.&#xa;Resolved evaluation fixture; not evidence of an executed service." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontStyle=0;"><mxGeometry x="60" y="90" width="460" height="65" as="geometry"/></mxCell><mxCell id="token" value="Example token claims: cognito:username=alex; custom:tenantId=T-001;&#xa;custom:type=Customer; cognito:groups=[Customers]" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontStyle=0;"><mxGeometry x="600" y="65" width="1130" height="45" as="geometry"/></mxCell><object id="aws" label="AWS Cloud&#xa;[Deployment node]" c4Type="Deployment node" technology="" vendor="AWS" iconKey="aws4-d0472fc38ac34dce"><mxCell vertex="1" parent="1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=0;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;fontFamily=Arial;labelWidth=200;spacingTop=8;"><mxGeometry x="600" y="130" width="1240" height="740" as="geometry