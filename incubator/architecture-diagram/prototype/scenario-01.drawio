et="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#545b64;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=0;dashed=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="authorize" value="3. Pass token&#xa;[AWS invocation]" edge="1" parent="1" source="gateway" target="authorizer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#545b64;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=0;dashed=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;"><mxGeometry x="-0.5" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1336" y="488"/></Array></mxGeometry></mxCell><mxCell id="query" value="4. Query policy [HTTPS]" edge="1" parent="1" source="authorizer" target="policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#545b64;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=0;dashed=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.5;entryPerimeter=0;"><mxGeometry x="0.7" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="forward" value="5. Forward allowed request&#xa;[HTTPS]" edge="1" parent="1" source="gateway" target="backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#545b64;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=0;dashed=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitPerimeter=0;entryX=0;entryY=0.75;entryPerimeter=0;"><mxGeometry x="0.62" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="failure" value="5'. Authorization failure: HTTP 403 [HTTPS]" edge="1" parent="1" source="gateway" target="web" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#545b64;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontStyle=1;dashed=0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.25;entryY=0;entryPerimeter=0;"><mxGeometry x="-0.25" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1116" y="430"/><mxPoint x="300" y="430"/></Array></mxGeometry></mxCell><mxCell id="legend" value="Legend&#xa;AWS service tiles: pinned draw.io AWS4 icons.&#xa;White box: custom container. Actor glyph: person.&#xa;Outlined groups: deployment node or system boundary.&#xa;Solid: main call. Dashed: auxiliary policy query.&#xa;Bold relationship: failure response. Arrows: caller to callee." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontStyle=0;"><mxGeometry x="60" y="680" width="460" height="150" as="geometry"/></mxCell><mxCell id="assumptions" value="Prototype assumptions (not owner approvals): generic Web app and REST API;&#xa;HTTPS on external calls; generic AWS invocation for the authorizer.&#xa;The planted password-verification error is corrected only in this fixture." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontStyle=0;"><mxGeometry x="600" y="905" width="1190" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
