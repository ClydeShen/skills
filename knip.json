{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "harness/*.mjs",
    "evals/*.test.mjs",
    "incubator/*/evals/suite.mjs",
    "incubator/*/evals/image-facts-suite.mjs",
    "incubator/*/evals/*.test.{mjs,cjs}",
    "incubator/*/evals/{run,promptfooconfig}.cjs",
    "incubator/*/candidate/*/scripts/*.mjs",
    "incubator/*/tools/*.mjs",
    "*.config.mjs"
  ],
  "project": ["harness/**", "evals/**", "incubator/**/*.{mjs,cjs}", "!incubator/*/evals/*-20??-??-??/**"],
  "ignoreDependencies": ["@commitlint/cli", "dependency-cruiser"]
}
