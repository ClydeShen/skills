{
  "name": "personal-agent-skills",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "check": "node harness/run.mjs",
    "check:repo": "node harness/check.mjs",
    "git:setup": "node harness/git-policy.mjs setup",
    "git:check": "node harness/git-policy.mjs check",
    "lint:agents": "agnix .",
    "skills:sync": "node harness/sync-skills.mjs --write",
    "test": "node --test harness/*.test.mjs evals/harness.test.mjs incubator/*/evals/*.test.mjs",
    "test:transport": "node --test evals/provider.test.mjs",
    "eval": "node evals/run.mjs",
    "eval:model": "node evals/run.mjs --mode model",
    "eval:nvidia": "node evals/run.mjs --mode model --provider nvidia"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "fast-xml-parser": "5.11.2",
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.3",
    "promptfoo": "0.125.0",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "agnix": "0.59.3"
  }
}
