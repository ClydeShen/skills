{
  "name": "personal-agent-skills",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "check": "node harness/run.mjs",
    "check:repo": "node harness/check.mjs",
    "check:static": "node harness/static.mjs",
    "check:pr": "node harness/pr-check.mjs",
    "fix": "biome check --write . && prettier --write --log-level=warn .",
    "git:setup": "node harness/git-policy.mjs setup",
    "git:check": "node harness/git-policy.mjs check",
    "lint:agents": "agnix .",
    "skills:sync": "node harness/sync-skills.mjs --write",
    "skill:check": "node harness/skill-quality.mjs",
    "skill:report": "node harness/skill-quality.mjs --report",
    "security:scan": "node harness/skill-security.mjs",
    "test": "node --test harness/*.test.mjs evals/harness.test.mjs evals/vision-judge.test.mjs evals/trigger-suite.test.mjs incubator/*/evals/*.test.mjs",
    "test:transport": "node --test evals/provider.test.mjs",
    "eval": "node evals/run.mjs",
    "eval:model": "node evals/run.mjs --mode model",
    "eval:nvidia": "node evals/run.mjs --mode model --provider nvidia",
    "prepare": "node harness/prepare.mjs",
    "eval:agents:setup": "npm install --no-save --no-audit --no-fund @anthropic-ai/claude-agent-sdk@0.3.296 @openai/codex-sdk@0.156.1",
    "eval:trigger": "node evals/run.mjs --mode model --suite evals/trigger-suite.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.7.1",
    "fast-xml-parser": "5.11.2",
    "github-slugger": "2.0.0",
    "knip": "6.44.1",
    "markdown-it": "15.0.3",
    "prettier": "3.9.10",
    "promptfoo": "0.125.0",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "agnix": "0.59.3"
  }
}
